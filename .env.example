# OmniVerifier Server Configuration
HOST=0.0.0.0
PORT=8099
RUST_LOG=info,omni_verifier=debug,actix_web=info
MAX_PAYLOAD_SIZE_MB=50

# Maximum images allowed per verification request (e.g. 5, 10)
MAX_IMAGES_PER_REQUEST=5

# Server-Side Secure API Keys (All keys are completely OPTIONAL)
# You only need to set the key for the provider(s) you wish to use.
# Self-hosted models (Ollama, vLLM) require no API keys at all.
DEEPSEEK_API_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Optional Base URL Overrides for Local / Self-Hosted Models
# Default for Ollama is http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
# NOTE for Docker users: If running OmniVerifier in Docker and Ollama on your host machine, use:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Optional: Custom self-hosted vLLM, LocalAI, or Hugging Face Endpoint
# VLLM_BASE_URL=http://localhost:8000/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Custom Proxies / AI Gateways for Gemini and Anthropic
# (Defaults: https://generativelanguage.googleapis.com and https://api.anthropic.com)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
